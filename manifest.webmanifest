{
 "name": "TASSO'",
 "short_name": "TASSO'",
 "description": "TASSO' : scan de documents, photos d'identité (IRCC, DV, Schengen), appareil photo intelligent et QR codes.",
 "lang": "fr",
 "start_url": "./index.html",
 "scope": "./",
 "display": "standalone",
 "background_color": "#0c3a8c",
 "theme_color": "#0c3a8c",
 "icons": [
  {
   "src": "icon-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "any"
  },
  {
   "src": "icon-mask-192.png",
   "sizes": "192x192",
   "type": "image/png",
   "purpose": "maskable"
  },
  {
   "src": "icon-mask-512.png",
   "sizes": "512x512",
   "type": "image/png",
   "purpose": "maskable"
  }
 ],
 "share_target": {
  "action": "./share-target",
  "method": "POST",
  "enctype": "multipart/form-data",
  "params": {
   "title": "title",
   "text": "text",
   "files": [
    {
     "name": "media",
     "accept": [
      "image/*",
      ".jpg",
      ".jpeg",
      ".png",
      ".webp",
      ".heic",
      "application/pdf",
      ".pdf"
     ]
    }
   ]
  }
 }
}